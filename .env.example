RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_VERIFICATION_MODE=true

# SMTP account verification (Gmail users: use a Google App Password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
SPRING_MAIL_FROM=your_email@gmail.com
BUILDO_OTP_DEVELOPMENT_FALLBACK=false

# Required for Docker Compose and JWT signing. Set strong values before running.
POSTGRES_PASSWORD=
BUILDO_JWT_SECRET=
VITE_UPI_ID=
VITE_UPI_PAYEE_NAME=
